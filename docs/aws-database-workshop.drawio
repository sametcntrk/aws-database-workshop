<mxfile host="Electron" version="29.6.1"><diagram name="Architecture" id="architecture"><mxGraphModel dx="5650" dy="2424" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="5650" pageHeight="2424" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title-group" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="40" y="30" width="5570" height="90" as="geometry" /></mxCell><mxCell id="title-text" value="Lale Market on AWS - ten databases behind one shop (Frankfurt)" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="0" y="0" width="1600" height="42" as="geometry" /></mxCell><mxCell id="subtitle-text" value="https://dbworkshop.tdsynnexlab.link/&amp;lt;engine&amp;gt;/ → one HTTPS ALB → ten EC2 Engine Apps. Each app seeds its own e-commerce data into its own Engine, reads it back and shows both on a web page." style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="42" width="2400" height="25" as="geometry" /></mxCell><mxCell id="title-separator" value="" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="72" width="5560" height="10" as="geometry" /></mxCell><mxCell id="aws-cloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=light-dark(#232F3E0D,#232F3E0D);fillStyle=auto;verticalAlign=top;align=left;