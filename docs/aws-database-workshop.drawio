l id="iam-sm-b" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3362" y="1692" width="26" height="15" as="geometry" /></mxCell><mxCell id="e-sec-redshift" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D13212;rounded=0;strokeWidth=2;fontFamily=Helvetica;startArrow=block;startFill=1;dashed=1;dashPattern=8 4;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-app-redshift" target="grp-vpce-sm-c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3788" y="1120" /><mxPoint x="4226" y="1120" /></Array></mxGeometry></mxCell><mxCell id="e-sec-influxdb" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D13212;rounded=0;strokeWidth=2;fontFamily=Helvetica;startArrow=block;startFill=1;dashed=1;dashPattern=8 4;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-app-influxdb" target="grp-vpce-sm-c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3958" y="1138" /><mxPoint x="4262" y="1138" /></Array></mxGeometry></mxCell><mxCell id="step-s2-4b-c" value="4-Con-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="4106" y="1126" width="76" height="28" as="geometry" /></mxCell><mxCell id="e-vpce-sm-c" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D13212;rounded=0;strokeWidth=2;fontFamily=Helvetica;startArrow=block;startFill=1;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-vpce-sm-c" target="grp-secrets"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4495" y="1325" /><mxPoint x="4495" y="1830" /></Array></mxGeometry></mxCell><mxCell id="iam-sm-c" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="4482" y="1692" width="26" height="15" as="geometry" /></mxCell><mxCell id="step-s2-5b" value="5-Con-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="3463.0" y="1618.0" width="76" height="28" as="geometry" /></mxCell><mxCell id="legend-bg-s1" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#007CBD;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="680" height="1750" as="geometry" /></mxCell><mxCell id="legend-container-s1" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="60" y="170" width="640" height="1710" as="geometry" /></mxCell><mxCell id="legend-head-s1" value="&lt;div style=&quot;font-size:17px;color:#007CBD&quot;&gt;&lt;b&gt;Scenario 1 - Participant-initiated (inbound)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A participant opens an Engine App page and presses Seed or Read.&lt;br&gt;&lt;b&gt;Connection A (Con-A)&lt;/b&gt; = browser ↔ Route 53 (DNS)&lt;br&gt;&lt;b&gt;Connection B (Con-B)&lt;/b&gt; = browser ↔ ALB (the ALB terminates TLS)&lt;br&gt;&lt;b&gt;Connection C (Con-C)&lt;/b&gt; = ALB ↔ Engine App (new connection)&lt;br&gt;&lt;b&gt;Connection D (Con-D)&lt;/b&gt; = Engine App ↔ its Engine (new connection)&lt;br&gt;&lt;b&gt;Connection E (Con-E)&lt;/b&gt; = Aurora → Redshift zero-ETL (managed by AWS)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1"><mxGeometry x="0" y="0" width="640" height="130" as="geometry" /></mxCell><mxCell id="step-s1-1a-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1" connectable="0"><mxGeometry x="0" y="142" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s1-1a-badge-legend" value="1-Con-A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-1a-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s1-1a-desc-legend" value="&lt;div&gt;&lt;b&gt;DNS lookup&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser asks Route 53 for dbworkshop.tdsynnexlab.link (Con-A, UDP 53 to 192.0.2.53 (Route 53 name server, example)). The alias A record returns the three ALB node public IPs, e.g. 198.51.100.20 (ALB node b public IP).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-1a-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s1-2b-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1" connectable="0"><mxGeometry x="0" y="252" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s1-2b-badge-legend" value="2-Con-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-2b-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s1-2b-desc-legend" value="&lt;div&gt;&lt;b&gt;Browser to IGW (HTTPS 443)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser opens Con-B to 198.51.100.20:443. The IGW does DNAT: dst → 10.20.1.25 (ALB node b private IP). dbws-rt-public-b 10.20.0.0/16 → local delivers it.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-2b-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s1-3b-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1" connectable="0"><mxGeometry x="0" y="362" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s1-3b-badge-legend" value="3-Con-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-3b-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s1-3b-desc-legend" value="&lt;div&gt;&lt;b&gt;IGW to ALB&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The ALB terminates Con-B (TLS, ACM certificate for dbworkshop.tdsynnexlab.link). HTTP :80 only redirects to HTTPS.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-3b-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s1-4c-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1" connectable="0"><mxGeometry x="0" y="472" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s1-4c-badge-legend" value="4-Con-C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-4c-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s1-4c-desc-legend" value="&lt;div&gt;&lt;b&gt;ALB path rule to Engine App&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The listener rule matches the path and forwards to that app's target group: /dynamodb/* → tg-dynamodb → DynamoDB App 10.20.10.11:8000. The ALB opens Con-C (HTTP 8000). Cross-zone is on: any ALB node reaches any app. sg-app-&amp;lt;engine&amp;gt; allows 8000 only from sg-alb.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-4c-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s1-5d-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1" connectable="0"><mxGeometry x="0" y="582" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s1-5d-badge-legend" value="5-Con-D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-5d-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s1-5d-desc-legend" value="&lt;div&gt;&lt;b&gt;Engine App to its Engine&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The app opens Con-D to its own Engine only, with the protocol written on the arrow (PostgreSQL wire, MongoDB wire, RESP, CQL, HTTPS API). Each engine SG allows its port only from that one app's SG. TLS everywhere.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-5d-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s1-6d-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1" connectable="0"><mxGeometry x="0" y="692" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s1-6d-badge-legend" value="6-Con-D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-6d-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s1-6d-desc-legend" value="&lt;div&gt;&lt;b&gt;Through a VPC endpoint&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;DynamoDB and S3: dbws-rt-app-a pl-dynamodb / pl-s3 → gateway endpoint (no ENI, no IP). Keyspaces: cassandra.eu-central-1.amazonaws.com resolves to 10.20.20.200 (interface endpoint ENI a private IP). The service checks the request against the app's IAM role (SigV4).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-6d-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s1-7e-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1" connectable="0"><mxGeometry x="0" y="802" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s1-7e-badge-legend" value="7-Con-E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-7e-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s1-7e-desc-legend" value="&lt;div&gt;&lt;b&gt;Aurora to Redshift (zero-ETL)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The zero-ETL integration copies every committed change of the Aurora tables to the Redshift database aurora_live. No Engine App takes part, and no pipeline code exists. The sales report reads the new order within seconds.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-7e-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="legend-sg-s1" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Security groups&lt;/b&gt;&lt;br&gt;sg-alb: in 443, 80 from AllowedCidr&lt;br&gt;sg-app-&amp;lt;engine&amp;gt;: in 8000 from sg-alb&lt;br&gt;sg-db-&amp;lt;engine&amp;gt;: in engine port from sg-app-&amp;lt;engine&amp;gt; only (5432, 5439, 6379-6380, 8086, 8182, 27017, 443)&lt;br&gt;sg-vpce: in 443, 9142 from the three app subnets&lt;br&gt;&lt;b&gt;Who translates&lt;/b&gt;&lt;br&gt;IGW = DNAT on the way in, the reverse on the way out (1:1 per public IP). NAT GW = SNAT for outbound connections.&lt;br&gt;&lt;b&gt;IP addresses&lt;/b&gt;&lt;br&gt;EC2 IPs are fixed in the template. Engine, ALB, NAT and endpoint IPs are examples from the subnet ranges; internet IPs are RFC 5737 examples.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fontFamily=Helvetica;" vertex="1" parent="legend-container-s1"><mxGeometry x="0" y="918" width="640" height="270" as="geometry" /></mxCell><mxCell id="legend-bg-s2" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="4930" y="150" width="680" height="1750" as="geometry" /></mxCell><mxCell id="legend-container-s2" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="4950" y="170" width="640" height="1710" as="geometry" /></mxCell><mxCell id="legend-head-s2" value="&lt;div style=&quot;font-size:17px;color:#ED7100&quot;&gt;&lt;b&gt;Scenario 2 - Engine App-initiated (outbound, at boot)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Every Engine App downloads its code at boot (drawn for the DynamoDB App).&lt;br&gt;&lt;b&gt;Connection A (Con-A)&lt;/b&gt; = Engine App ↔ github.com / pypi.org. The NAT gateway rewrites the source address but does not terminate the connection.&lt;br&gt;&lt;b&gt;Connection B (Con-B)&lt;/b&gt; = Engine App ↔ Secrets Manager through the interface endpoint (red dashed).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-s2"><mxGeometry x="0" y="0" width="640" height="130" as="geometry" /></mxCell><mxCell id="step-s2-1a-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s2" connectable="0"><mxGeometry x="0" y="142" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s2-1a-badge-legend" value="1-Con-A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-1a-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s2-1a-desc-legend" value="&lt;div&gt;&lt;b&gt;Engine App to NAT GW (boot)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;UserData clones the Engine App code and installs packages: Con-A from 10.20.10.11 (DynamoDB App private IP) to 192.0.2.80:443 (github.com, example). dbws-rt-app-a 0/0 → NAT GW a. SNAT by NAT GW: src → 10.20.0.50 (NAT GW a private IP).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-1a-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s2-2a-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s2" connectable="0"><mxGeometry x="0" y="252" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s2-2a-badge-legend" value="2-Con-A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-2a-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s2-2a-desc-legend" value="&lt;div&gt;&lt;b&gt;NAT GW to IGW&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;dbws-rt-public-a 0/0 → IGW. The NAT GW rewrites the source but does not terminate the connection, so it stays Con-A.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-2a-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s2-3a-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s2" connectable="0"><mxGeometry x="0" y="362" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s2-3a-badge-legend" value="3-Con-A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-3a-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s2-3a-desc-legend" value="&lt;div&gt;&lt;b&gt;IGW to github.com / pypi.org&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;IGW 1:1 NAT: src 10.20.0.50 → 198.51.100.50 (NAT GW a Elastic IP). Return: IGW DNAT back, then the NAT GW reverses its SNAT.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-3a-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s2-4b-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s2" connectable="0"><mxGeometry x="0" y="472" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s2-4b-badge-legend" value="4-Con-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-4b-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s2-4b-desc-legend" value="&lt;div&gt;&lt;b&gt;Engine App to Secrets endpoint&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Apps that log in with a password (Aurora, Redshift, DocumentDB, ElastiCache, InfluxDB) read their secret at start: Con-B to secretsmanager.eu-central-1.amazonaws.com:443, which private DNS resolves to the endpoint ENI in the same AZ, e.g. 10.20.20.210 (Secrets endpoint ENI a private IP).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-4b-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="step-s2-5b-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-s2" connectable="0"><mxGeometry x="0" y="582" width="640" height="104" as="geometry" /></mxCell><mxCell id="step-s2-5b-badge-legend" value="5-Con-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-5b-legend"><mxGeometry x="0" y="2" width="92" height="34" as="geometry" /></mxCell><mxCell id="step-s2-5b-desc-legend" value="&lt;div&gt;&lt;b&gt;Endpoint to Secrets Manager&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;PrivateLink carries Con-B to Secrets Manager; no NAT, no internet. The app role may read only its own dbws/&amp;lt;engine&amp;gt; secret.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-5b-legend"><mxGeometry x="104" y="0" width="536" height="104" as="geometry" /></mxCell><mxCell id="legend-key-s2" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;How to read this page&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Box titles&lt;/b&gt; = resource type: Internet gateway, NAT gateway, Load balancer, Interface endpoint, Gateway endpoint, Engine App, Secrets store; data layer = &amp;lt;data category&amp;gt; DB (Relational DB, Graph DB, …) or Object store.&lt;br&gt;• &lt;b&gt;Path label&lt;/b&gt; above an Engine App = the ALB rule that sends traffic to it.&lt;br&gt;• &lt;b&gt;Text on a data arrow&lt;/b&gt; = protocol, port and how the app authenticates.&lt;br&gt;• &lt;b style='color:#DD344C'&gt;IAM role icon&lt;/b&gt; on a line = the Engine App's IAM role authorizes this call (SigV4); no password.&lt;br&gt;• &lt;b style='color:#D13212'&gt;Red dashed&lt;/b&gt; = secret retrieval through the Secrets Manager interface endpoint of the same AZ.&lt;br&gt;• SSM endpoints (ssm, ssmmessages, ec2messages) exist in the data subnets for Session Manager but are not drawn.&lt;br&gt;• Every Engine App also reads the dbws/admin secret (Admin Console key); these calls are not drawn.&lt;br&gt;• &lt;b style='color:#8C4FFF'&gt;Purple dashed&lt;/b&gt; = Engine-to-Engine replication (zero-ETL).&lt;br&gt;• One Engine App talks to exactly one Engine; its IAM role and security group allow nothing else.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#DD344C;dashed=1;spacing=8;fontFamily=Helvetica;" vertex="1" parent="legend-container-s2"><mxGeometry x="0" y="698" width="640" height="330" as="geometry" /></mxCell><mxCell id="frame-walk-s1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1940" width="5570" height="210" as="geometry" /></mxCell><mxCell id="walk-s1-title" value="&lt;b style=&quot;color:#147EBA&quot;&gt;Scenario 1 packet walk - request direction (replies swap src and dst and take the same hops back)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1948" width="5542" height="24" as="geometry" /></mxCell><mxCell id="walk-s1-n0" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-n1" value="Route 53" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="732" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-n2" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1405" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-n3" value="Internet gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2078" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-n4" value="ALB node b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2750" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-n5" value="ALB node b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3422" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-n6" value="Aurora App (EC2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="4095" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-n7" value="Aurora App (EC2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="4768" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-n8" value="Aurora writer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1E1E1E);strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="5440" y="2070" width="150" height="46" as="geometry" /></mxCell><mxCell id="walk-s1-e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;rounded=0;strokeWidth=2;fontFamily=Helvetica;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="walk-s1-n0" target="walk-s1-n1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr0" value="&lt;b&gt;src&lt;/b&gt; 203.0.113.10:53001&lt;br&gt;&lt;b&gt;dst&lt;/b&gt; 192.0.2.53:53 (Route 53 NS)&lt;br&gt;&lt;i style='font-size:10px'&gt;answer: ALB public IPs&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="218" y="1980" width="506" height="80" as="geometry" /></mxCell><mxCell id="walk-s1-b0" value="1-Con-A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="250.0" y="2108.0" width="76" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-brk1" value="&lt;b&gt;Con-A ends · the browser opens Con-B to the ALB&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;rounded=1;dashed=1;strokeColor=#147EBA;fillColor=none;fontColor=#147EBA;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="890" y="1980" width="506" height="128" as="geometry" /></mxCell><mxCell id="walk-s1-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;rounded=0;strokeWidth=2;fontFamily=Helvetica;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="walk-s1-n2" target="walk-s1-n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr2" value="&lt;b&gt;src&lt;/b&gt; 203.0.113.10:51514&lt;br&gt;&lt;b&gt;dst&lt;/b&gt; 198.51.100.20:443 (ALB node b public)&lt;br&gt;&lt;i style='font-size:10px'&gt;as sent by the browser&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1563" y="1980" width="506" height="80" as="geometry" /></mxCell><mxCell id="walk-s1-b2" value="2-Con-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1595.0" y="2108.0" width="76" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;rounded=0;strokeWidth=2;fontFamily=Helvetica;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="walk-s1-n3" target="walk-s1-n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr3" value="&lt;b&gt;src&lt;/b&gt; 203.0.113.10:51514&lt;br&gt;&lt;b&gt;dst&lt;/b&gt; 10.20.1.25:443 (ALB node b private)&lt;br&gt;&lt;i style='font-size:10px'&gt;DNAT by IGW: dst public → private&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2236" y="1980" width="506" height="80" as="geometry" /></mxCell><mxCell id="walk-s1-b3" value="3-Con-B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2268.0" y="2108.0" width="76" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-brk4" value="&lt;b&gt;Con-B ends at the ALB (TLS) · rule /aurora/* → tg-aurora&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;rounded=1;dashed=1;strokeColor=#147EBA;fillColor=none;fontColor=#147EBA;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2908" y="1980" width="506" height="128" as="geometry" /></mxCell><mxCell id="walk-s1-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;rounded=0;strokeWidth=2;fontFamily=Helvetica;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="walk-s1-n5" target="walk-s1-n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr5" value="&lt;b&gt;src&lt;/b&gt; 10.20.1.25:40112&lt