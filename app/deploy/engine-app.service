[Unit]
Description=AWS Database Workshop Engine App
After=network-online.target
Wants=network-online.target

[Service]
User=engineapp
Group=engineapp
WorkingDirectory=/opt/engine-app/app
EnvironmentFile=/etc/engine-app.env
ExecStart=/opt/engine-app/venv/bin/gunicorn --workers 2 --threads 4 --bind 0.0.0.0:8000 --timeout 300 --access-logfile - engine_app.web:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
